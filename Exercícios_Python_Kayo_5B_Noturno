        "#19. Ângulo entre dois arrays (produto escalar normalizado)\n",
        "import numpy as np\n",
        "\n",
        "array1 = np.random.randint(1, 11, 20)\n",
        "array2 = np.random.randint(1, 11, 20)\n",
        "\n",
        "produto_escalar = np.dot(array1, array2)\n",
        "\n",
        "tamanho1 = np.linalg.norm(array1)\n",
        "tamanho2 = np.linalg.norm(array2)\n",
        "\n",
        "cos_angulo = produto_escalar / (tamanho1 * tamanho2)\n",
        "\n",
        "angulo = np.arccos(cos_angulo)\n",
        "\n",
        "angulo_graus = np.degrees(angulo)\n",
        "\n",
        "print(\"Array 1:\")\n",
        "print(array1)\n",
        "\n",
        "print(\"Array 2:\")\n",
        "print(array2)\n",
